# Forensic (Service 1) compose has no scanner profiles.
# Start Service 3 with: docker compose -f services/vuln/docker-compose.yml --profile gvm --profile vuln-scanners up
COMPOSE_PROFILES=
# forensic | mobile-extract | vuln — each process is one product
AETHERIS_SERVICE=forensic
# Database
DATABASE_URL=postgresql+psycopg2://forensic:forensic@localhost:5434/forensic

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=0
# Must be identical on forensic, mobile-extract, and vuln so the emailed token matches.
CLIENT_TOKEN_SECRET=change-me-to-the-same-value-on-all-three-products
FORENSIC_APP_URL=http://localhost:3001
MOBILE_EXTRACT_APP_URL=http://localhost:3001
VULN_APP_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3001

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ndate1976@gmail.com
MAIL_PASSWORD=txluyrnweevhiblr
MAIL_FROM=ndate1976@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Port 587 uses STARTTLS. For 465 use MAIL_SMTP_SSL=true and STARTTLS=false.
MAIL_SMTP_SSL=false
# Forensic (identity) sends user mail. Mobile extract and vuln compose set this false.
# pgAdmin (docker compose — http://localhost:5052; default image UI is port 80 inside container)
PGADMIN_PORT=5052
PGADMIN_DEFAULT_EMAIL=admin@forensic.local
PGADMIN_DEFAULT_PASSWORD=admin

# Platform Superadmin (SQL 002 + 036 and API bootstrap upsert this account)
# Login: organization `platform`, email below, password below.
PLATFORM_ADMIN_EMAIL=superadmin@admin.com
PLATFORM_ADMIN_PASSWORD=admin@123456789

# MinIO (Phase 2 extracted disk storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=forensic
MINIO_SECURE=false

# Redis / Celery
# Host publication is only for local diagnostics; containers always use redis:6379.
# Run scripts/select-free-redis-port.ps1 before startup if 6380 is occupied.
REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0

# Host evidence (disk segments stay on examiner drive — path registration only)
HOST_EVIDENCE_ENABLED=true
HOST_EVIDENCE_ROOT=
HOST_DRIVE_MAP=
HOST_PATH_MAPPINGS=
HOST_EVIDENCE_PATH=./evidence
DATA_ROOT=./data
# Disk/mobile job files, MinIO objects, Ollama models, and Hugging Face caches.
# This is a normal folder, outside DockerDesktopWSL. To move it, stop the stack,
# move the folder, then change this path and start again.
# Example: AETHERIS_BACKUP_DIR=F:/PolaronBackup
AETHERIS_BACKUP_DIR=./backup
# MinIO objects (extracted shards). Put this on a drive with plenty of free space.
# Example: MINIO_DATA_DIR=F:/PolaronBackup/minio
# MINIO_DATA_DIR=./backup/minio

# Extracted disk build performance (safe for 2–3 concurrent cases)
EXTRACT_DISK_WORKERS=8
# UFED/mobile zip dumps — start wide; adaptive governor shrinks live under load/heat.
EXTRACT_MOBILE_WORKERS=4
EXTRACT_UPLOAD_CONCURRENCY=8
EXTRACT_ZSTD_LEVEL=1
MAX_CONCURRENT_DISK_BUILDS=3
# forensic = RAG evidence set only (skips WinSxS/DLL noise). defensible = court-safe superset. full = every file.
EXTRACT_MODE=forensic
EXTRACT_UNCERTAIN_MAX_BYTES=4194304
# Ignored for Windows full mode. Forensic mode uses its own selective include rules.
EXTRACT_SKIP_SYSTEM_PATHS=false
EXTRACT_MAX_FILE_BYTES=0
EXTRACT_HASH_FILES=false
EXTRACT_PROGRESS_STEP=5000
# Default forensic flow: extract evidence exactly once, finalize the evidence manifest, then post-process.
EXTRACT_THEN_PROCESS=true
PHASE3_STREAM_DURING_EXTRACT=false
# Keep GPU OCR/RAG behind the extraction barrier so the image walk/copy owns I/O while active.
PHASE3_STREAM_RAG_DURING_EXTRACT=false
PHASE3_STREAM_OCR_DURING_EXTRACT=false

# GPU RAG / Phase 3 pipeline (thermal/OOM-safe defaults)
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_FALLBACK=nomic-embed-text
RAG_IMAGE_EMBED_MODEL=clip-ViT-B-32
HF_PULL_MODELS=BAAI/bge-m3,zai-org/GLM-OCR,sentence-transformers/clip-ViT-B-32,cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_DEVICE=cuda
RAG_BATCH_SIZE=24
RAG_BATCH_SIZE_CAP=48
RAG_CUDA_MEMORY_FRACTION=0.55
RAG_CHUNK_SIZE=2500
RAG_CHUNK_OVERLAP=800
RAG_AUTO_AFTER_DISK=false
RAG_EMBEDDING_ENABLED=false
RAG_BACKGROUND_AFTER_BASELINE=false
PHASE3_AUTO_AFTER_DISK=true

# Dynamic performance — probe CPU/RAM/GPU room and retune knobs on each worker/API start
DYNAMIC_PERF_ENABLED=true
DYNAMIC_PERF_FORCE=true
# Comma-separated env keys that must never be overwritten (optional)
DYNAMIC_PERF_LOCK=PARSE_WORKERS,PARSE_PARALLEL_BUCKETS,FORENSIC_WORKER_CONCURRENCY,MAX_CONCURRENT_DISK_BUILDS

# Host-wide adaptive semaphore. Keep URL blank to use this stack's REDIS_URL.
# When forensic + mobile-extract share one physical host, set BOTH stacks to a
# Redis URL reachable from both containers so GPU/CPU permits are coordinated.
RESOURCE_GOVERNOR_ENABLED=true
RESOURCE_GOVERNOR_REDIS_URL=redis://redis:6379/15
RESOURCE_GOVERNOR_GROUP=aetheris-host
RESOURCE_GOVERNOR_FAIL_OPEN_ON_UNAVAILABLE=true
RESOURCE_GOVERNOR_CPU_MAX_SLOTS=8
RESOURCE_GOVERNOR_GPU_MAX_SLOTS=4
GPU_RELEASE_MODEL_AFTER_TASK=true

# GPU thermal governor (laptop-safe — throttle before hard shutdown)
GPU_THERMAL_ENABLED=true
GPU_THERMAL_START_MAX_C=90
GPU_THERMAL_THROTTLE_C=85
GPU_THERMAL_PAUSE_C=90
GPU_THERMAL_RESUME_C=82
GPU_THERMAL_POLL_SEC=3
GPU_THERMAL_HOT_BATCH_SLEEP_SEC=4
GPU_THERMAL_EMBED_REST_SEC=0.5
GPU_THERMAL_DUTY_CYCLE_BATCHES=8
GPU_THERMAL_DUTY_CYCLE_REST_SEC=3
GPU_THERMAL_ADAPTIVE_BATCH=true
GPU_THERMAL_COOL_BOOST_C=55
GPU_THERMAL_COOL_BATCH_MULTIPLIER=1.25
GPU_THERMAL_FALLBACK_DUTY=true
GPU_THERMAL_RISE_DELTA_C=4
GPU_THERMAL_RISE_WINDOW_SEC=20
# Optional nvidia-smi power cap in watts (80–90 for laptop GPUs; 0 = off)
GPU_THERMAL_POWER_LIMIT_W=85
GPU_THERMAL_UNLOAD_OLLAMA_BEFORE_RAG=true
GPU_THERMAL_ABORT_C=90
GPU_THERMAL_HONOR_ENV=true
# Configured ceiling. Adaptive governor keeps 12 GB/laptop GPUs at one heavy
# OCR/RAG model and permits two only on larger, cool cards with VRAM headroom.
GPU_HEAVY_MAX_CONCURRENT=1
CPU_THERMAL_THROTTLE_C=86
CPU_THERMAL_PAUSE_C=94

PARSE_WORKERS=6
PARSE_PARALLEL_BUCKETS=6
# Background parse drain — bounded Celery rounds + per-file timeout avoids silent multi-hour stalls
PARSE_DRAIN_MAX_ROUNDS=5
PARSE_DRAIN_BATCH_LIMIT=100
PARSE_FILE_TIMEOUT_SEC=0
# 0 = no wall-clock kill for extract / acquire / scan steps (nginx proxy is 7 days).
LONG_JOB_TIMEOUT_SEC=0
# Partition CPU/RAM/GPU/NPU when forensic + mobile-extract + vuln run together.
AETHERIS_SHARE_HOST=true
# Force NPU on/off if auto-detect is wrong (Intel AI Boost, Qualcomm Hexagon, /dev/accel).
# AETHERIS_NPU=true
# AETHERIS_NPU_NAME=Intel AI Boost

# Ollama: ollama-init pulls a GPU-capacity required set, then accuracy extras
# that fit VRAM (14b on 12GB, 32b on 20GB+, 72b on 40GB+).
OLLAMA_BASE_URL=http://ollama:11434
# Extra names always merged into the required list (still pulled after GPU probe).
OLLAMA_PULL_MODELS=qwen2.5:14b,qwen2.5:7b,deepseek-r1:14b,llama3.1:8b,gemma4:12b,qwen3.5:9b,nomic-embed-text
OLLAMA_PULL_ACCURACY=true
OLLAMA_PULL_IGNORE_GPU=false
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
LLM_PRIMARY_MODEL=qwen2.5:14b
LLM_REVIEW_MODEL=deepseek-r1:14b
LLM_REVIEW_MODEL_LARGE=deepseek-r1:14b
LLM_FAST_MODEL=qwen3.5:9b
LLM_DUAL_REVIEW_ENABLED=true

# Neo4j GraphRAG
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forensic123

# OpenSearch hybrid retrieval
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=forensic

# Retrieval tuning (Step 12 eval harness)
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=1.0
RETRIEVAL_DEFAULT_TOP_K=10
# Additive Image Evidence RAG (HLD) — optional vision vectors; image-evidence jobs always embed
RAG_IMAGE_EMBED_ENABLED=false
RAG_IMAGE_EMBED_MODEL=clip-ViT-B-32
RAG_IMAGE_EMBED_DIM=512
# Default intensity when starting Image Evidence (FAST|STANDARD|DEEP|VISUAL-SIMILARITY).
# Does not change which agents run — only OCR/embed depth. Changeable in the UI per job.
RAG_DEFAULT_PROCESSING_PROFILE=STANDARD
# High-quality OCR page/token budget for image-evidence jobs
RAG_IMAGE_OCR_MAX_PAGES=200
RAG_IMAGE_OCR_MAX_NEW_TOKENS=2048
OCR_MAX_PAGES=8
OCR_MAX_NEW_TOKENS=512
OCR_MAX_IMAGE_EDGE=1280
OCR_CPU_WORKERS=4
MOBILE_QUALITY_CPU_WORKERS=6
MOBILE_QUALITY_BATCH=250
MOBILE_QUALITY_VIDEO_FRAMES=4
MOBILE_QUALITY_MAX_READ_BYTES=268435456
OCR_VIDEO_MAX_FRAMES=6

# Vulnerability / Nessus module (isolated from forensic extract/RAG)
VULN_MODULE_ENABLED=true
VITE_VULN_MODULE_ENABLED=true
NESSUS_API_TIMEOUT_SEC=0
NESSUS_VERIFY_SSL=true
NESSUS_DEFAULT_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# Greenbone / OpenVAS (profile: gvm)
GVM_HOST=gvmd
GVM_PORT=9390
GVM_URL=unix:///run/gvmd/gvmd.sock
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
GVM_USERNAME=admin
GVM_PASSWORD=admin
GVM_ADMIN_PASSWORD=admin
GVM_VERIFY_TLS=false
GVM_LIVE_ENABLED=true
GVM_SCAN_POLL_INTERVAL_SEC=5
GVM_SCAN_TIMEOUT_SEC=0
GVM_SCAN_NEAR_COMPLETE_GRACE_SEC=0
GVM_SCAN_NEAR_COMPLETE_PROGRESS_PCT=85
GVM_SCAN_STALL_PROGRESS_PCT=95
GVM_SCAN_STALL_SEC=0
GVM_SCAN_CONFIG=Full and fast
VULN_SEVERITY_PROFILE=aetheris
GVM_FEED_READY_TIMEOUT_SEC=0
GVM_FEED_READY_POLL_INTERVAL_SEC=15
GVM_PORT_PROFILE=full
GVM_TARGET_PORT_RANGE=
GVM_MAX_CHECKS=20
GVM_MAX_HOSTS=4
GVM_OPTIMIZE_TEST=false
GVM_PLUGINS_TIMEOUT_SEC=0
GVM_SCANNER_PLUGINS_TIMEOUT_SEC=0
VULN_ORCH_OVERLAP_ENABLED=true

# Premise parallel vuln scan jobs (worker-nessus only; disk/mobile/report stay concurrency 1).
# 3–4 scan cases run at once. OpenVAS prefs are not scaled down for parallel jobs.
NESSUS_WORKER_CONCURRENCY=4
VULN_MAX_PARALLEL_JOBS=4
VULN_PARALLEL_MIN_PACE=0.45

# Multi-scanner orchestration
VULN_ORCHESTRATION_ENABLED=true
VULN_ALLOW_STUB_FINDINGS=false
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=changeme
ZAP_SCAN_TIMEOUT_SEC=0
ZAP_PORT=8090
TRIVY_SERVER_URL=http://trivy:4954
TRIVY_PORT=4954
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_INDEXER_PASSWORD=SecretPassword
# Wazuh indexer JVM heap (default 1g; use 2g if still OOM with other heavy containers)
WAZUH_INDEXER_JAVA_OPTS=-Xms1g -Xmx1g -XX:MaxDirectMemorySize=512m
WAZUH_VERIFY_TLS=false
WAZUH_API_PORT=55000

# Frontend host drive helper (Windows workstation)
VITE_HOST_DRIVE_HELPER_URL=http://127.0.0.1:9876
# Docker/API reaches the same Windows helper through Docker Desktop's host gateway.
HOST_DRIVE_HELPER_URL=http://host.docker.internal:9876
# '+' makes HttpListener reachable from Docker. ensure-host-drive-helper.ps1 configures the URL ACL.
HOST_DRIVE_HELPER_BIND_HOST=+
# One-time on examiner PC: scripts\install-host-drive-helper-task.ps1 (auto-start at logon)
VITE_HOST_DRIVE_HELPER_TOKEN=
GVM_REPORT_MIN_QOD=0
GVM_MIN_NVT_COUNT=10000
GVM_ALLOW_BARE_TASK_FALLBACK=false
GVM_SAFE_CHECKS=true
GVM_CHECKS_READ_TIMEOUT=10
GVM_TIMEOUT_RETRY=3
GVM_OPEN_SOCK_MAX_ATTEMPTS=5
GVM_EXPAND_VHOSTS=true
GVM_TEST_EMPTY_VHOST=true

# List folder: wall-clock cap for deep directory walks (seconds, 0 = no cap). Case-layout
# runs (05_Exports/<run> with export_catalog.json) never deep-walk and ignore this.
LIST_FOLDER_MAX_SECONDS=900

# Mobile export layout: 05_Exports/<run> holds exactly <run>.zip/.ufd/.pas/.ufdx.
# Set to 1 only if you need multi-part .part-NNNNN.zip output (resumable, legacy).
AETHERIS_EXPORT_SHARDS=0

# Disk/Mobile serial stages; forensic code also enforces the four-unit ceiling.
PIPELINE_SEQUENTIAL_AGENTS=true
EXTRACT_READ_SEMAPHORE=6
OCR_PARALLEL_BUCKETS=0
OCR_GPU_ONLY=true
OCR_DEVICE=cuda
PARSE_DRAIN_INTERLEAVE_RAG=false
AXIOM_INVENTORY_WORKERS=4
OCR_DOCUMENTS_ONLY=false
MOBILE_WORKER_DB_POOL_SIZE=6
MOBILE_WORKER_DB_MAX_OVERFLOW=4

# Source-linked image/video observations (Disk and Mobile; no vector embedding)
FORENSIC_MEDIA_REVIEW_ENABLED=true
FORENSIC_MEDIA_VISION_MODEL=qwen3.5:9b
FORENSIC_VIDEO_SAMPLE_SECONDS=10
FORENSIC_VIDEO_MAX_FRAMES=0
FORENSIC_MEDIA_VISION_TIMEOUT_SECONDS=300

# Single Disk / Mobile progress coordinator (CPU only).
PROGRESS_AGENT_INTERVAL_SECONDS=15
PROGRESS_AGENT_JOB_BATCH=200
FORENSIC_STAGE_IDLE_TIMEOUT_SECONDS=300

# V53 throughput profile: 60 GB evidence-ready target in <=35 minutes on capable media
EXTRACT_SHARD_COUNT=12
EXTRACT_TAR_BUFSIZE=8388608
EXTRACT_READ_CHUNK_BYTES=8388608
EXTRACT_HDD_CHUNK_BYTES=16777216
EXTRACT_SPOOL_MAX_BYTES=134217728
MINIO_UPLOAD_PARALLEL=6
MINIO_UPLOAD_PART_MB=64
EXTRACT_TARGET_GB=60
EXTRACT_TARGET_MINUTES=35

# V67 restart-safe pipeline + high-precision company leakage candidates
STARTUP_RESUME_STALE_SECONDS=45
COMPANY_LEAKAGE_MIN_SCORE=55
COMPANY_LEAKAGE_TERMS=
COMPANY_BRANDS=
QUALITY_TRIAGE_BATCH=1200
QUALITY_TRIAGE_CPU_WORKERS=6

# V72 WhatsApp encrypted/deleted evidence recovery
WHATSAPP_EXTERNAL_TOOLS_ENABLED=1
WHATSAPP_EXTERNAL_TOOL_TIMEOUT_SEC=300
WHATSAPP_DELETED_RECOVERY_ENABLED=1
