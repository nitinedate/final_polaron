    {
      "port": "67-68/udp",
      "service": "dhcp",
      "reason": "network-scoped protocol; it cannot be checked against one IP address"
    },
    {
      "port": "138/udp",
      "service": "netbios-dgm",
      "reason": "datagram service with no separate checks; NetBIOS issues are reported on 137/udp and SMB ports"
    },
