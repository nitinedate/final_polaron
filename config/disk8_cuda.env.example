# DISK8 + CUDA controlled performance overlay (merge into production .env).
# Do not overwrite the existing .env: it contains environment-specific secrets.
# Confirm source media. On HDD, the adaptive I/O planner reduces readers automatically.
# These are ceilings, not a promise of 8 simultaneous disk reads on a slow HDD.
DISK_SLOTS=8
PIPELINE_PARALLEL_SLOTS=8
MAX_PARALLELISM=8
EXTRACT_DISK_WORKERS=8
EXTRACT_READ_SEMAPHORE=8
EXTRACT_UPLOAD_CONCURRENCY=8
PARSE_WORKERS=8
PARSE_SHARD_SIDECARS=5
PARSE_PARALLEL_ENABLED=true
EARLY_GPU_OCR=1
OCR_DEVICE=cuda
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_BATCH_SIZE=16
RAG_BATCH_SIZE_CAP=16
RAG_CUDA_MEMORY_FRACTION=0.40
# OCR and embeddings overlap CPU tasks but share one exclusive GPU on 12GB VRAM.
GPU_HEAVY_MAX_CONCURRENT=1
EXTRACT_THEN_PROCESS=true
EXTRACT_HASH_FILES=true
# Faster but experimental option remains opt-in after hash/coverage A/B validation.
EXTRACT_DIRECT_TAR_STREAM=false
# One simultaneous heavy disk image recommended for a laptop/SSD.
MAX_CONCURRENT_DISK_BUILDS=1
# Preserve scope intentionally. 'full' requires more time than selective 'forensic'.
EXTRACT_MODE=forensic
# Use 'full' to examine signatures even for recognized OS runtime binaries.
DISK_PRIORITY_SIGNATURE_MODE=safe_deferred
# Put scratch on an SSD with sufficient free capacity (replace with YOUR path).
# EXTRACT_SCRATCH_HOST_DIR=D:/PolaronScratch
# Actual source should be measured; valid setting: hdd, ssd or nvme.
# DISK_SOURCE_MEDIA=ssd
