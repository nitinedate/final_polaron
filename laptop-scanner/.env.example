# Point at Service 3 (Vulnerabilities) only — not forensic or mobile-extract.
# Site root; scanner-agent appends /api/scanner-agent/... itself.
# Local split: http://host.docker.internal:3003  (or :8082 if hitting the API)
CENTRAL_API_URL=https://122.179.140.167

# Legacy LAN discovery fallback only. Used only when CENTRAL_API_URL=AUTO.
# After the split the vuln API health role is vuln-api (port 8082 / UI 3003).
CENTRAL_API_PORT=8082

# Firm tenant slug (same as login organization / X-Tenant)
TENANT_SLUG=aetheris

# Filled automatically by Start-Laptop (kept in sync with scanner-agent/.agent-token).
AGENT_TOKEN=replace-me
# Leftover from older laptops. Start-Laptop still tries it, then promotes a match into AGENT_TOKEN.
AGENT_RECOVERY_TOKEN=

# Do not use these to skip login. Start-Laptop always asks for the emailed
# access token (same token as Forensic / Mobile extract web login).
FIRM_EMAIL=
FIRM_PASSWORD=
# Optional. Bind this laptop to a specific scanner instead of auto-picking.
# SCANNER_NAME=Laptop-MYPC
# SCANNER_ID=p

# Local Greenbone admin (set on first start by Start-Laptop)
GVM_USERNAME=admin
GVM_PASSWORD=admin
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
# Greenbone feed-backed resources (including Full and fast) are repaired automatically
# on startup if gvmd has not imported them yet. No Docker volumes are deleted.
AUTO_REPAIR_GREENBONE=true
GREENBONE_INITIAL_WAIT_MIN=10
GREENBONE_RECOVERY_WAIT_MIN=20

# Agent tuning
POLL_INTERVAL_SEC=15
HEARTBEAT_INTERVAL_SEC=60
QUEUE_POLL_INTERVAL_SEC=3
# V1.9.6: how long a successful Greenbone readiness check is reused (seconds).
# The dispatcher runs every QUEUE_POLL_INTERVAL_SEC; without this, gvmd was probed
# every ~4 s. Not-ready is re-checked on every pass regardless.
READINESS_RECHECK_SEC=60
STALL_PROGRESS_PCT=95
STALL_SEC=0
# Port scope when a scan has no policy/template (V1.6.7):
#   nexus   = DEFAULT. The service port policy (scanner-agent/agent/service_port_policy.json):
#             67 services that can produce Low+ findings, 87 TCP + 25 UDP ports.
#             UDP_PORT_RANGE and PORT_DISCOVERY_RANGE are ignored for nexus;
#             add ports with SERVICE_EXTRA_TCP_PORTS / SERVICE_EXTRA_UDP_PORTS.
#   nessus  = wider: Greenbone "All IANA assigned TCP" list + catalog (slower)
#   full    = all 65,535 TCP ports
PORT_PROFILE=nexus
# Deprecated: any value (including 600) is ignored and cannot stop a scan.
# Keep 0 for clarity; delete older 600s settings from existing .env files.
SCAN_IP_BUDGET_SEC=0
# Full mode assesses all TCP ports and priority UDP services.
# Optional fast/vuln modes retain their configured port scope after discovery;
# a connect pre-probe is an observation and never removes silent/filtered services.
UDP_PROFILE=priority
# Optional additive ports, e.g. 2222,9443 or 28000-28010. Policy settings can override them.
SCAN_TCP_CUSTOM_PORTS=
SCAN_UDP_CUSTOM_PORTS=
PORT_DISCOVERY_ENABLED=true
PORT_DISCOVERY_TIMEOUT_SEC=0.25
PORT_DISCOVERY_WORKERS=32
PORT_DISCOVERY_RANGE=T:21-23,25,53,80,81,88,110,111,135,139,143,389,443,445,465,587,631,993,995,1433,1521,1723,2049,3000,3306,3389,5432,5672,5900,5985,6379,6443,8080,8443,9000,9418,27017
VERIFY_TLS=true
# Bootstrap/authentication uses Linux Docker + OpenSSL, not Windows Schannel/SSPI.
BOOTSTRAP_TRANSPORT=docker
# Control-plane calls must be bounded. Never use an unlimited read timeout.
# Short connect timeout prevents an unreachable WAN gateway from blocking scan polls.
CENTRAL_API_TIMEOUT_SEC=15
CENTRAL_API_CONNECT_TIMEOUT_SEC=4
# Final result uploads can be large; they retry separately until accepted.
CENTRAL_RESULT_TIMEOUT_SEC=120
# Reduce repeat large progress payloads while preserving periodic UI updates.
PROGRESS_REPORT_INTERVAL_SEC=45
AGENT_VERSION=1.7.0

# persistent_edge | portable  (must match the scanner role in the central UI)
SCANNER_ROLE=portable

# Parallelism: one Scan Job in the UI; each IP is its own OpenVAS chunk.
# SLO profile: 15-18 IP/hour. Auto uses 5-6 one-IP workers based on CPU/thermal headroom.
# Warm/hot hosts reduce new admissions; critical thermal/RAM pressure pauses NEW starts.
# Existing OpenVAS tasks always finish and release their permit.
MAX_CONCURRENT_SCAN_JOBS=1
SCAN_IP_PARALLELISM=auto
SCAN_IP_MAX_PARALLELISM=6
# Checks (NVTs) OpenVAS runs at once against ONE IP, 1-32 (V1.9.3: no longer clamped
# to 3-4). The larger of this and FAST_MAX_CHECKS (5) is used, and is what the job log shows.
SCAN_SERVICE_PARALLELISM=6
# V1.10.3 per-IP port semaphore (wins over SCAN_SERVICE_PARALLELISM)
SCAN_PORT_SEMAPHORE=6
SCAN_SLO_MIN_HOSTS_PER_HOUR=15
SCAN_SLO_HOSTS_PER_HOUR=18
SCAN_EXPECTED_HOST_MINUTES=20
GVM_MAX_HOSTS=1
GVM_MAX_CHECKS=8
# Thermal/load admission for new OpenVAS IP tasks. Existing tasks finish safely.
SCAN_CPU_THROTTLE_C=84
SCAN_CPU_PAUSE_C=92
# Optional when container cannot read host sensors; a host monitor can publish it.
# SCAN_HOST_TEMP_C=
# Quick reachability is non-authoritative by default so firewalled live hosts are not lost.
SKIP_UNREACHABLE_TARGETS=false
REACHABILITY_TIMEOUT_SEC=0.5
REACHABILITY_WORKERS=10
# Durable per-IP JSONL logs are also shipped through the normal scanner log API.
IP_SCAN_LOG_DIR=/app/logs/ip
# Print each of the 52 requested services and evidence-backed severity to docker logs.
SERVICE_AUDIT_ENABLED=true
SERVICE_AUDIT_INCLUDE_UNTESTED=true
SERVICE_AUDIT_LOG_FINDINGS=true
SERVICE_AUDIT_MAX_FINDING_LINES=100
HIGH_PROGRESS_WARN_SEC=300
# V1.9.3: per-IP time limit in seconds, measured for EACH IP from its own OpenVAS
# task start (until V1.9.2 it was one clock for the whole job, so the 2nd IP of a
# job only got what the 1st left over). 0 = no limit. When an IP reaches it, that
# IP's task is stopped, its findings are kept, and the host is reported finished at
# the time limit (never clean). SCAN_IP_DEADLINE_SEC, if set, takes precedence.
MAX_SCAN_RUNTIME_SEC=0
# Optional limit for a whole job (all IPs together). 0 = off (recommended): with a
# per-IP limit every IP already ends on its own.
MAX_JOB_RUNTIME_SEC=0

# Full VA result fidelity
GVM_REPORT_MIN_QOD=0
# Refuse scans while the Greenbone feed/config is visibly incomplete.
GVM_MIN_NVT_COUNT=10000
# Never silently create a bare task if Greenbone rejects quality preferences.
GVM_ALLOW_BARE_TASK_FALLBACK=false
# Nessus default is yes (only run checks for detected services). Set no for the pre-1.6.5 behaviour.
GVM_OPTIMIZE_TEST=yes
GVM_SAFE_CHECKS=yes
GVM_EXPAND_VHOSTS=yes
GVM_TEST_EMPTY_VHOST=yes
GVM_CHECKS_READ_TIMEOUT=10
GVM_TIMEOUT_RETRY=3
GVM_OPEN_SOCK_MAX_ATTEMPTS=5

# Complete scanner/NVT budgets; do not truncate the full port sweep.
PLUGINS_TIMEOUT_SEC=320
SCANNER_PLUGINS_TIMEOUT_SEC=36000
HIGH_PROGRESS_STALL_SEC=0

# Stop/cancel GMP request timeout; failed acknowledgement never deletes findings.
GVM_STOP_TIMEOUT_SEC=8

# Organization-specific vulnerability severity from numeric CVSS (v2/v3/v4).
# Critical 8.0-10.0 | High 6.0-7.9 | Medium 4.0-5.9 | Low 0.1-3.9 | Info 0.0
# These are CUSTOM bands, not the standard CVSS qualitative severity scale.
VULN_SEVERITY_CRITICAL_MIN=8.0
VULN_SEVERITY_HIGH_MIN=6.0
VULN_SEVERITY_MEDIUM_MIN=4.0
VULN_SEVERITY_LOW_MIN=0.1

# --- V1.6.6 scan speed and hang handling ---------------------------------
# fast     = Nessus/OpenVAS-default socket timeout (5 s), 5 checks per host,
#            Nmap Aggressive (T4) timing, and learned timeout caps for checks
#            that already timed out repeatedly. Every check still runs.
# standard = pre-1.6.6 behaviour. A scan policy can choose per job.
#
# turbo (V1.9.0, recommended for speed): the biggest win for a single IP.
# Host-level concurrency does nothing with one host, so turbo runs many more
# NVT CHECKS at once against that host - CPU-aware, default 4x CPU cores,
# capped at 40 (TURBO_MAX_CHECKS_CAP). On an 8-core laptop that is ~32
# concurrent checks instead of the Nessus-default 5-8, roughly a 4-6x speedup
# on the NVT phase. Coverage is unchanged (every applicable NVT still runs);
# a stuck check is capped at 180 s so it cannot pin the host at 98%. Needs
# enough CPU/RAM on the OpenVAS container (Docker Desktop > Resources) and is
# best with GVM_OPTIMIZE_TEST=yes. Tune with the TURBO_* knobs below.
SCAN_PERFORMANCE=turbo
TURBO_CHECKS_PER_CPU=4
TURBO_MAX_CHECKS_CAP=40
# TURBO_MAX_CHECKS=32          # set an absolute value to ignore the CPU formula
TURBO_CHECKS_READ_TIMEOUT=5
TURBO_PLUGINS_TIMEOUT=180
TURBO_NMAP_TIMING=Aggressive
# Absolute ceiling on per-host check concurrency for any profile (raised 16->128).
GVM_MAX_CHECKS_CAP=128
# fast = Nessus-default 5 simultaneous checks; milder than turbo.
FAST_CHECKS_READ_TIMEOUT=5
FAST_MAX_CHECKS=5
FAST_NMAP_TIMING=Aggressive
# A check (NVT) that hit its 320 s timeout NVT_HANG_MIN_EVENTS times in
# NVT_HANG_WINDOW_DAYS gets NVT_HANG_CAP_SEC in fast mode. Port scanners and
# web crawlers are never capped. Inspect with Show-Hang-Stats.cmd.
NVT_HANG_CAPS=true
NVT_HANG_CAP_SEC=60
NVT_HANG_MIN_EVENTS=2
NVT_HANG_WINDOW_DAYS=30
# Stalled-task watchdog: seconds with NO progress before the agent stops a
# task and reports the host incomplete (stalled). 0 disables a rule.
SCAN_IP_STALL_SEC=1800
SCAN_PORTSCAN_STALL_SEC=3600
SCAN_TASK_START_STALL_SEC=900

# --- V1.6.7 time guarantees -------------------------------------------------
# Per-check (NVT) limit, written onto the scan config so OpenVAS uses it.
# 320 s = Nessus/OpenVAS default (V1.6.8: no reduction).
FAST_PLUGINS_TIMEOUT=320
# Optional hard per-IP limit. 0 = use MAX_SCAN_RUNTIME_SEC (per IP since V1.9.3).
SCAN_IP_DEADLINE_SEC=0
# Fixed number of IPs scanned at once (1-32). 0 = old adaptive sizing (minimum 5).
# Other IPs of a job wait for a free slot; each IP's time limit starts when its own
# OpenVAS task starts. Rough guide: 4 on a 4-core/8 GB laptop, 6-8 on 8 cores/16 GB.
SCAN_IP_WORKERS_FIXED=5
# V1.10.3 IP semaphore (wins over SCAN_IP_WORKERS_FIXED)
SCAN_IP_SEMAPHORE=5
SCAN_INTERRUPTED_RESTARTS=1
# V1.9.7: a host that answered none of the pre-probe ports (no open port, no TCP
# reset) and is still in OpenVAS's port scan (0%) after this many seconds is
# stopped and reported "no response - not assessed", so its slot goes to the next
# IP. Matters most for all-port templates (Advanced, Exhaustive). 0 = off.
SCAN_SILENT_HOST_SEC=900

# --- V1.6.8 vulnerability-focused scanning -------------------------------
# vulnerability = run only checks that can report Critical/High/Medium/Low,
#   plus the detection checks they depend on (auto-loaded by OpenVAS) and a
#   few cheap host/port reporting checks. Brute force, compliance/policy and
#   NSE wrappers are skipped (Nessus does not brute force by default).
# all = every check in "Full and fast", including informational ones.
SCAN_CHECK_SCOPE=vulnerability
# auto = never stop a scan for being slow; stop only when OpenVAS's own log
#   shows nothing running on the host (scanner process died).
# off = never stop.  stop = old time-based stop after SCAN_IP_STALL_SEC.
SCAN_STALL_ACTION=auto
# Written into openvas.conf by configure-openvas: log each check launch/finish so the
# agent can name what an IP is waiting on. After changing it (or OPENVAS_LOG_LEVEL):
#   docker compose up -d --force-recreate configure-openvas
# (a plain "up -d" does not re-run that one-shot container). V1.9.5: it is NOT set on
# scan configs - gvmd sends it as "1", which OpenVAS reads as off.
OPENVAS_LOG_WHOLE_ATTACK=yes
# V1.9.3: upper bound for any single check's OWN timeout. OpenVAS uses a check's
# script_timeout instead of plugins_timeout; checks declaring 30-60 min, or no limit,
# are what hold a host at 98-99 %. They are capped to this many seconds (port scanners,
# service detection and web crawlers never are). 0 = off. Needs the gvm_vt_data mount
# on scanner-agent (docker compose up -d scanner-agent).
SCAN_NVT_MAX_SEC=900
# openvas.log level: 127 = upstream default (no DEBUG). 128 = DEBUG floods the log
# during SSL/TLS cipher checks (the agent then cannot see running checks) and may
# log passwords. Apply with: docker compose up -d configure-openvas
OPENVAS_LOG_LEVEL=127

# --- V1.9.0 authenticated scanning (laptop-local credentials) ---------------
# Set an SMB (Windows) or SSH (Linux) login here to make a Nexpose/Nessus Full
# audit run *authenticated*, which is what surfaces missing-patch High/Critical
# findings. The agent creates the matching Greenbone credential automatically
# and binds it to the scan; the secret NEVER leaves this laptop and is never
# sent to or stored by the central server.
#
# SMB / Windows (username + password; add a domain for DOMAIN\user NTLM login):
SCAN_SMB_USERNAME=
SCAN_SMB_PASSWORD=
SCAN_SMB_DOMAIN=
# SSH / Linux (password, OR a private key which takes precedence):
SCAN_SSH_USERNAME=
SCAN_SSH_PASSWORD=
SCAN_SSH_PRIVATE_KEY=
SCAN_SSH_KEY_PASSPHRASE=
# Alternatively point at a local JSON file with the same keys (smb_username etc.):
SCAN_CREDENTIALS_FILE=
# on  = auto-bind any configured credential to every scan (default).
# off = bind only when the policy explicitly sets require_credentials.
SCAN_AUTO_CREDENTIALS=on
