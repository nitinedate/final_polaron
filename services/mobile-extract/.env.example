AETHERIS_SERVICE=mobile-extract
VULN_MODULE_ENABLED=false
VITE_AETHERIS_SERVICE=mobile-extract
# UI http://localhost:3002  API http://localhost:8081  DB localhost:5434 database forensic
# Host USB helper remains http://127.0.0.1:9876
# Same CLIENT_TOKEN_SECRET on all three products — emailed token is shared.
CLIENT_TOKEN_SECRET=change-me-to-the-same-value-on-all-three-products
FORENSIC_APP_URL=http://localhost:3001
MOBILE_EXTRACT_APP_URL=http://localhost:3002
VULN_APP_URL=http://localhost:3003
APP_BASE_URL=http://localhost:3002

# Adaptive host resource governor. For cross-stack coordination, use the same
# reachable Redis URL and group as the forensic stack. Blank = mobile Redis only.
RESOURCE_GOVERNOR_ENABLED=true
RESOURCE_GOVERNOR_REDIS_URL=
RESOURCE_GOVERNOR_GROUP=aetheris-host
RESOURCE_GOVERNOR_FAIL_OPEN_ON_UNAVAILABLE=true
EXTRACT_MOBILE_WORKERS=8
MAX_CONCURRENT_DISK_BUILDS=3

# Thermal ceilings passed into the mobile worker containers.
GPU_THERMAL_ENABLED=true
GPU_THERMAL_THROTTLE_C=87
GPU_THERMAL_PAUSE_C=92
GPU_THERMAL_RESUME_C=84
GPU_THERMAL_ABORT_C=94
GPU_HEAVY_MAX_CONCURRENT=2
CPU_THERMAL_THROTTLE_C=86
CPU_THERMAL_PAUSE_C=94

GPU_RELEASE_MODEL_AFTER_TASK=true
