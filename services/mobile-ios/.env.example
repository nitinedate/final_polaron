# Ios mobile forensics service overrides
AETHERIS_SERVICE=mobile-ios
RESOURCE_GOVERNOR_ENABLED=true
RESOURCE_GOVERNOR_REDIS_URL=redis://redis:6379/15
RESOURCE_GOVERNOR_GROUP=aetheris-host
RESOURCE_GOVERNOR_FAIL_OPEN_ON_UNAVAILABLE=true
RESOURCE_GOVERNOR_CPU_MAX_SLOTS=8
RESOURCE_GOVERNOR_GPU_MAX_SLOTS=4
GPU_RELEASE_MODEL_AFTER_TASK=true
MOBILE_BUILD_CONCURRENCY=3
MOBILE_MAX_CONCURRENT_BUILDS=3
MOBILE_REPORT_CONCURRENCY=2
EXTRACT_MOBILE_WORKERS=8
GPU_HEAVY_MAX_CONCURRENT=2
GPU_THERMAL_THROTTLE_C=87
GPU_THERMAL_PAUSE_C=92
CPU_THERMAL_THROTTLE_C=86
CPU_THERMAL_PAUSE_C=94

# Platform-private server-side evidence root. Do not point Android and iOS at the same folder.
IOS_HOST_EVIDENCE_PATH=./evidence/ios
